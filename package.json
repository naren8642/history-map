{
  "name": "history-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "harvest": "tsx scripts/harvest.ts",
    "harvest:smoke": "tsx scripts/harvest.ts --from 1800 --to 1850",
    "curate": "tsx scripts/curate.ts",
    "inspect": "tsx scripts/inspect.ts",
    "data": "npm run harvest && npm run harvest:span && npm run harvest:polities && npm run locate && npm run narratives && npm run curate && npm run stage && npm run prefetch",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prefetch": "tsx scripts/prefetch-summaries.ts",
    "stage": "cp data/raw/p585.curated.json public/data/events.json && cp data/raw/narratives.json public/data/narratives.json",
    "harvest:span": "tsx scripts/harvest.ts --span",
    "narratives": "tsx scripts/narratives.ts",
    "harvest:polities": "tsx scripts/harvest-polities.ts",
    "locate": "tsx scripts/locate-polities.ts",
    "explain": "tsx scripts/explain.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supercluster": "^9.0.0"
  }
}
